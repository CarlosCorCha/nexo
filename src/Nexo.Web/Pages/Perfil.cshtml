@page
@model Nexo.Web.Pages.PerfilModel
@using Nexo.Web.Infrastructure
@{ ViewData["Title"] = "Mi perfil"; }
<div class="page-content narrow-content"><p class="eyebrow">MI ESPACIO / PERFIL</p><h1>Así entras en Nexo<span class="accent">.</span></h1><p class="intro">La información de tu cuenta de demostración.</p>
<section class="profile-card"><div class="profile-heading"><span class="avatar" aria-hidden="true">@Model.Account.DisplayName[..1]</span><div><h2>@Model.Account.DisplayName</h2><p>@string.Join(", ", Model.Roles)</p></div></div><dl class="profile-data"><div><dt>Usuario</dt><dd>@Model.Account.UserName</dd></div><div><dt>Correo de demostración</dt><dd>@Model.Account.Email</dd></div><div><dt>Último acceso guardado</dt><dd>@OfficeTime.Format(Model.Account.LastAccessUtc)<small>Hora de la sede · Europe/Madrid</small></dd></div></dl></section>
<p class="footnote">Esta consulta muestra exclusivamente los datos de tu sesión.</p><a class="text-link" asp-page="/Index">← Volver a mi espacio</a></div>
