@page "/Administracion"
@model Nexo.Web.Pages.Administracion.IndexModel
@using Nexo.Web.Infrastructure
@{ ViewData["Title"] = "Administración"; }
<div class="page-content">
    <a class="back-link" asp-page="/Index">← Mi espacio</a>
    <div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Personas y accesos<span class="accent">.</span></h1><p class="intro">Cada persona, con su perfil y su espacio.</p></div><span class="role-badge">Solo administración</span></div>
    <section class="table-card" aria-labelledby="accounts-title">
        <div class="table-heading"><div><h2 id="accounts-title">Perfiles de demostración</h2><p>Consulta de las cuentas disponibles en Nexo.</p></div><span class="count-badge">@Model.Accounts.Count cuentas</span></div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Cuentas, perfiles y últimos accesos">
            <table><caption class="visually-hidden">Cuentas, perfiles y últimos accesos guardados</caption><thead><tr><th scope="col">Persona</th><th scope="col">Usuario</th><th scope="col">Perfil</th><th scope="col">Último acceso</th></tr></thead>
            <tbody>@foreach (var account in Model.Accounts) {<tr><th scope="row"><span class="table-person"><span class="table-avatar" aria-hidden="true">@account.Name[..1]</span>@account.Name</span></th><td><code class="user-code">@account.UserName</code></td><td><span class="role-badge">@account.Role</span></td><td>@OfficeTime.Format(account.LastAccess)</td></tr>}</tbody></table>
        </div>
        <p class="table-mobile-hint">Desliza la tabla para consultar todos los datos →</p>
    </section>
    <p class="footnote">Consulta de solo lectura. Las cuentas de demostración están precargadas.</p>
</div>
